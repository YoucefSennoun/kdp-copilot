        "https://www.amazon.co.jp/gp/new-releases/*",
        "https://www.amazon.com.mx/gp/new-releases/*",
        "https://www.amazon.br/gp/new-releases/*",
        "https://www.amazon.com.au/gp/new-releases/*",
        "https://www.amazon.in/gp/bestsellers/*",
