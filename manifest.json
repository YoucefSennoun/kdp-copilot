{
  "manifest_version": 3,
  "name": "KDP Copilot",
  "version": "0.8.13",
  "description": "Amazon KDP Niche & Keyword Research Copilot — rules-v1 engine (fresh <6mo sellers, BSR≤200k, 1000/800 listing caps, author-brand & trademark screens, full A-Z search-volume proof, 20 markets, Books-only + format filter, FBA/MyResearchBase cross-check) + Gemini AI",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.it/*",
    "https://www.amazon.es/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.co.jp/*",
    "https://www.amazon.com.mx/*",
    "https://www.amazon.br/*",
    "https://www.amazon.com.au/*",
    "https://www.amazon.in/*",
    "https://www.amazon.nl/*",
    "https://www.amazon.se/*",
    "https://www.amazon.pl/*",
    "https://www.amazon.com.tr/*",
    "https://www.amazon.sa/*",
    "https://www.amazon.ae/*",
    "https://www.amazon.sg/*",
    "https://www.amazon.eg/*",
    "https://completion.amazon.com/*",
    "https://completion.amazon.co.uk/*",
    "https://completion.amazon.de/*",
    "https://completion.amazon.fr/*",
    "https://completion.amazon.it/*",
    "https://completion.amazon.es/*",
    "https://completion.amazon.ca/*",
    "https://completion.amazon.co.jp/*",
    "https://completion.amazon.com.mx/*",
    "https://completion.amazon.com.br/*",
    "https://completion.amazon.com.au/*",
    "https://completion.amazon.in/*",
    "https://completion.amazon.nl/*",
    "https://completion.amazon.se/*",
    "https://completion.amazon.pl/*",
    "https://completion.amazon.com.tr/*",
    "https://completion.amazon.sa/*",
    "https://completion.amazon.ae/*",
    "https://completion.amazon.sg/*",
    "https://completion.amazon.eg/*",
    "https://suggestqueries.google.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://opencode.ai/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open KDP Copilot Dashboard"
  },
  "commands": {
    "kdp-research-selection-us": {
      "description": "Research selected text on Amazon US (Books)",
      "suggested_key": { "default": "Alt+Shift+1", "mac": "Alt+Shift+1" }
    },
    "kdp-research-selection-uk": {
      "description": "Research selected text on Amazon UK (Books)"
    },
    "kdp-research-selection-de": {
      "description": "Research selected text on Amazon DE (Books)",
      "suggested_key": { "default": "Alt+Shift+3", "mac": "Alt+Shift+3" }
    },
    "kdp-research-selection-fr": {
      "description": "Research selected text on Amazon FR (Books)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/s*",
        "https://www.amazon.co.uk/s*",
        "https://www.amazon.de/s*",
        "https://www.amazon.fr/s*",
        "https://www.amazon.it/s*",
        "https://www.amazon.es/s*",
        "https://www.amazon.ca/s*",
        "https://www.amazon.co.jp/s*",
        "https://www.amazon.com.mx/s*",
        "https://www.amazon.br/s*",
        "https://www.amazon.com.au/s*",
        "https://www.amazon.in/s*",
        "https://www.amazon.nl/s*",
        "https://www.amazon.se/s*",
        "https://www.amazon.pl/s*",
        "https://www.amazon.com.tr/s*",
        "https://www.amazon.sa/s*",
        "https://www.amazon.ae/s*",
        "https://www.amazon.sg/s*",
        "https://www.amazon.eg/s*"
      ],
      "js": ["src/content/serp-parser.js"],
      "css": ["src/content/serp-panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/dp/*",
        "https://www.amazon.co.uk/dp/*",
        "https://www.amazon.de/dp/*",
        "https://www.amazon.fr/dp/*",
        "https://www.amazon.it/dp/*",
        "https://www.amazon.es/dp/*",
        "https://www.amazon.ca/dp/*",
        "https://www.amazon.co.jp/dp/*",
        "https://www.amazon.com.mx/dp/*",
