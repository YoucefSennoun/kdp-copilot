        "https://www.amazon.ae/gp/new-releases/*",
        "https://www.amazon.sg/gp/new-releases/*",
        "https://www.amazon.eg/gp/new-releases/*"
      ],
      "js": ["src/content/discovery-parser.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
