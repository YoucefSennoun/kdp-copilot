        "https://www.amazon.sg/gp/bestsellers/*",
        "https://www.amazon.eg/gp/bestsellers/*",
        "https://www.amazon.in/gp/movers-and-shakers/*",
        "https://www.amazon.nl/gp/movers-and-shakers/*",
        "https://www.amazon.se/gp/movers-and-shakers/*",
        "https://www.amazon.pl/gp/movers-and-shakers/*",
